rule merge_macs_prep:
    """
    Merge section:
    Combines all samples in samples.tsv into a single Seurat object.
    This improves consistency across all assays/samples.
    If multiple peaks files from select_peaks rule are found, performs granges reduction.
    Note that NA are imputed for cells lacking counts data.
    Example: Cells containing only GEX data will have NA for all ATAC peaks and vice versa.

    Peakcalling section:
    ZINBA: Combine peaks if needed
    MACS: Call peaks on full data set
    """
    input:
        markdown = "merge_macs_prep.Rmd",
        seurats = expand(
            "results/qc/{sample}-{replicate}.seurat_qc.rds",
            zip,
            sample = samples["sample"].tolist(),
            replicate = samples["replicate"].tolist()
            ),
        annotation = "results/build_annotation/annotation.rds",
        config = ancient(configuration),
    output:
        html = "results/merge_macs_prep/report.html",
        seurat = "results/merge_macs_prep/seurat.rds",
        bed = "results/merge_macs_prep/Multiome.bed",
    params:
        genome = samples['genome'].unique().tolist()[0],
        fragments = samples['fragments'].dropna().tolist(),
        scriptdir = "scripts",
    threads: 12
    resources:
        mem_mb=1024 * 100,
        disk_mb=1024 * 50,
        runtime=60 * 24
        # mem_mb=1024 * 200,
        # disk_mb=1024 * 100,
        # runtime=60 * 24
    shell:
        # File name written by Signac::SplitFragmentsBy() is variable, add cmd to rename
        """Rscript -e 'params = list(
                seurats = "{input.seurats}",
                annotation = "{input.annotation}",
                config = "{input.config}",
                seurat = "{output.seurat}",
                genome = "{params.genome}",
                fragments = "{params.fragments}",
                scriptdir = "{params.scriptdir}" );
            rmarkdown::render("{input.markdown}",
                params = params,
                output_file = "{output.html}" )';
        """
        """
        fragments_bed=($(find results/merge_macs_prep -name *.bed))
        if [[ ! ${{#fragments_bed[@]}} == 1 ]]
        then
            echo "config['macs']['split_frags_by'] choice generates more than 1 output bed file."
            echo "Please set 'split_frags_by' to a samples.tsv column shared across all ATAC/Multiome samples."
        elif [[ ! ${{fragments_bed[0]}} -ef results/merge_macs_prep/Multiome.bed ]]
        then
            echo "Output bed file is not named 'Multiome.bed', which is required for 'macs2' rule. Renaming."
            mv ${{fragments_bed[0]}} {output.bed}
        fi
        """

rule macs2:
    """
    This rule runs macs2 in command line
    """
    input:
        bed = "results/merge_macs_prep/Multiome.bed",
    output:
        tsvgz = "results/macs2/macspeaks.tsv.gz",
        tbi = "results/macs2/macspeaks.tsv.gz.tbi",
        peak = "results/macs2/NA_peaks.narrowPeak",
    params:
        tsv = "results/macs2/macspeaks.tsv"
    threads: 12
    resources:
        mem_mb=1024 * 100,
        disk_mb=1024 * 50,
        runtime=60 * 24
        # mem_mb=1024 * 200,
        # disk_mb=1024 * 100,
        # runtime=60 * 24
    shell:
        # NOTE: parallel takes input using {} and :::
        # {} in snakemake is problematic. Use {{}} for something else if you need it.
        "set +o pipefail; "
        "sort -k 1,1 -k 2 -V -s --parallel={threads} {input.bed} | grep 'chr' | uniq > {params.tsv} && "
        "sort -k 1,1 -k 2 -V -s --parallel={threads} {input.bed} | grep -v 'chr' | uniq >> {params.tsv} && "
        "bgzip --threads {threads} < {params.tsv} > {output.tsvgz} && "
        "parallel --max-procs={threads} "
            "'tabix -p bed --zero-based --force --begin 2 --end 3 {{}}' ::: {output.tsvgz} && "
        "parallel --max-procs={threads} "
            "'macs2 callpeak -t {{}} -f BED --nomodel --outdir results/macs2' ::: {output.tsvgz}"

