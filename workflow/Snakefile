# Import sampletable
samples = pd.read_table(config["samples"]).set_index(["sample", "replicate"], drop=False)
samples.index.names = ["sample", "replicate"]
samples.index = samples.index.set_levels(
    [i.astype(str) for i in samples.index.levels]
)  # enforce str in index

# Set chooser variables
resolutions = config['chooser']['resolutions']
chooser_sil = config['chooser']['silhouette']
user_resolution = config['cluster']['resolution']


####### helpers ###########

def is_activated(xpath):
    """Check if the rule specified by xpath is activated."""
    c = config
    for entry in xpath.split("/"):
        c = c.get(entry, {})
    return bool(c.get("activate", False))


def get_anno_rmd(wildcards):
    return 'annotation_ensdb.Rmd' if config["ANNOTATION"] == "EnsDb" else 'annotation_gtf.Rmd'

def get_tenx_type(wildcards):
    """Get matrix type (column name) from sample sheet."""
    cols = ['HDF5_Multiple_Assays', 'RDS_Multiple_Assays', 'Gene.Expression', 'Peaks', 'TF']
    df = samples[samples["sample"] == wildcards.sample]
    if wildcards.replicate != 'nan':
        df = df[df["replicate"] == wildcards.replicate]
    return df[cols].dropna(axis=1).columns.to_list()

def get_tenx(wildcards):
    """Get filtered matrix (hdf5/rds file or mex directory) path from sample sheet."""
    cols = ['HDF5_Multiple_Assays', 'RDS_Multiple_Assays', 'Gene.Expression', 'Peaks', 'TF']
    df = samples[samples["sample"] == wildcards.sample]
    if wildcards.replicate != 'nan':
        df = df[df["replicate"] == wildcards.replicate]
    return df[cols].dropna(axis=1).values.flatten().tolist()

def get_tsv_path(xpath):
    return xpath if os.path.exists(xpath) else ""

def get_groups(xpath):
    """Get group names from selected config section"""
    return list(config.get(xpath, {}).get("groups", {}).keys())

def get_assays(xpath):
    """
    Get assay names from selected config section.
    If using group integrate, need to specify assay_type
    """
    groups = config.get(xpath, {}).get("groups", {})
    # group_vals is a list of dict_values
    assay_names = [v['assay_name'] for v in groups.values()]
    return assay_names


####### rule inputs ###########
def get_cluster_inputs(wildcards):
    """
    Decide input file path for rules `chooser_paral` and `cluster`
    with or without integration
    """
    seurat = wildcards.seurat
    if seurat in get_groups("normalize"):
        return f"results/normalize_reduce_dims/{seurat}/{seurat}.rds"
    else:
        return f"results/integrate/{seurat}.rds"

def get_integrate_inputs(wildcards):
    seurat = "un" + wildcards.seurat
    return f"results/normalize_reduce_dims/{seurat}/{seurat}.rds",

def get_diff_test_inputs(wildcards):
    seurat = wildcards.seurat
    if seurat in get_groups("weighted_nn"):
        return f"results/wnn/{seurat}/clustered_data.rds"  
    else:
        return f"results/cluster/{seurat}/clustered_data.rds"

def determine_input():
    if config["macs2"]["run"] == "Y":
        return "results/add_macs_peaks/seurat.rds"
    elif config["macs2"]["run"] == "N":
        return "results/merge_zinba/seurat.rds"
    else:
        raise ValueError("Incorrect macs2 configuration - set 'Y' or 'N'")


####### valid inputs ##########
# Create a list storing all targets configured for normalization and integration
snn_targets = get_groups("normalize")

if is_activated("integrate"):
    snn_targets.extend(get_groups("integrate"))

# Filter the targets based on MACS2 configuration
if config["macs2"]["run"] == "N":
    # find any unitegrated assays containing "MACS"
    assays_list = get_assays("normalize")
    assays_list.extend(get_assays("integrate"))
    # subset snn_targets based on logicals checking "MACS"
    idx = [item != "MACS" for item in assays_list]
    snn_targets = list(compress(snn_targets, idx))

# Create a dictionary for rule-target pairs
d = {}
for key, value in config.items():
    if isinstance(value, dict):
        if "activate" in value.keys() or key == "normalize":
            d[key] = value["groups"]

valid_groups = {key:list(config[key]['groups'].keys()) for key in d.keys()}

####### cluster inputs ########

cluster_input = []
cluster_input.extend(
    expand(
        "results/cluster/{seurat}/clustered_data.rds",
        seurat=snn_targets
    )
)

if is_activated("weighted_nn"):
    cluster_input.extend(
        expand(
            "results/wnn/{seurat}/clustered_data.rds",
            seurat=valid_groups['weighted_nn']
        )
    )

####### all inputs ############

def all_input(wildcards):
    wanted_input = []

    if is_activated("diff_analysis"):
        wanted_input.extend(
            expand(
                "results/diff_analysis/{seurat}/markers.tsv",
                seurat=valid_groups['diff_analysis']
            )
        )

    if config["macs2"]["run"] == "Y":
        wanted_input.append("results/macs2/NA_treat_pileup.bigwig")
        wanted_input.append("results/macs2/NA_control_lambda.bigwig")

    wanted_input.append(
        "results/combine/seurat_combined.rds"
    )

    return wanted_input


