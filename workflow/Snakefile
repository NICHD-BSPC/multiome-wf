rule build_annotation:
    """
    This rule builds annotation from EnsDb or generic GTF
    'peaks' input used as placeholder. Reference in annotation_gtf.Rmd'
    commented out.
    Fix later : add something like "len(params.genome) == 1"
    "len(params.genome) == 1" only useful for ATAC Peaks annotation.
    Does not impact sample['genome'] where multi-species is supported.
    """
    input:
        markdown = get_anno_rmd,
    output:
        html = "results/build_annotation/report.html",
        anno_atac = "results/build_annotation/annotation.rds",
    params:
        anno_file = config["ANNO_FILE"],
        genome = samples['genome'].unique().tolist()[0],
    threads: 8
    resources:
        mem_mb=1024 * 200,
        disk_mb=1024 * 100,
        runtime=60 * 3
    shell:
        """Rscript -e 'params = list(
                anno_atac = "{output.anno_atac}",
                anno_file = "{params.anno_file}",
                genome = "{params.genome}" );
            rmarkdown::render("{input.markdown}",
                params = params,
                output_file = "{output.html}")'
        """

rule create_seurat:
    """
    Creates a seurat object with associated assays.
    Include a 'wildcards.units' in unlikely case of multiple technical reps.
    """
    input:
        markdown = "create_seurat.Rmd",
        tenx = get_tenx,
        annotation = "results/build_annotation/annotation.rds",
    output:
        html = "results/create_seurat/{sample}-{replicate}.report.html",
        seurat = "results/create_seurat/{sample}-{replicate}.seurat_raw.rds"
    params:
        tenx_type = get_tenx_type,
        scriptdir = "scripts",
        sample_tsv = config["samples"],
        aggregates_tsv = get_tsv_path(config["aggregates"]),
        assays_tsv = get_tsv_path(config["assays"]),
    threads: 12
    resources:
        mem_mb=1024 * 200,   # 1024 * 400 (400G) for real multiome dataset
        disk_mb=1024 * 100,  # 1024 * 200 (200G) for real multiome dataset
        runtime=60 * 12
    shell:
        """Rscript -e 'params = list(
                wc_sample = "{wildcards.sample}",
                wc_replicate = "{wildcards.replicate}",
                tenx = "{input.tenx}",
                annotation = "{input.annotation}",
                seurat = "{output.seurat}",
                tenx_type = "{params.tenx_type}",
                scriptdir = "{params.scriptdir}",
                sample_tsv = "{params.sample_tsv}",
                aggregates_tsv = "{params.aggregates_tsv}",
                assays_tsv = "{params.assays_tsv}" );
            rmarkdown::render("{input.markdown}",
                params = params,
                output_file = "{output.html}" )'
        """

rule qc:
    """
    Filters cell counts based on user-supplied column names present in Seurat metadata.
    Saves pre- and post-filtered violin plots if user wants to generate report later.

    Do this step individually, in case need to re-run QC/filtering with diff params.
    Little bit of I/O overhead worth it.
    """
    input:
        markdown = "qc.Rmd",
        seurat_in = "results/create_seurat/{sample}-{replicate}.seurat_raw.rds",
        config = ancient(configuration),
    output:
        html = "results/qc/{sample}-{replicate}.report.html",
        seurat_out = "results/qc/{sample}-{replicate}.seurat_qc.rds",
    params:
        scriptdir = "scripts",
        intermediates_dir="results/qc/{sample}-{replicate}",
        outdir = "results/qc"
    threads: 12
    resources:
        mem_mb=1024 * 200,
        disk_mb=1024 * 100,
        runtime=60 * 4
    shell:
        """Rscript -e 'params = list(
                seurat_in = "{input.seurat_in}",
                config = "{input.config}",
                seurat_out = "{output.seurat_out}",
                scriptdir = "{params.scriptdir}" );
            rmarkdown::render("{input.markdown}",
                params = params,
                intermediates_dir = "{params.intermediates_dir}",
                output_dir = "{params.outdir}",
                output_file = "{output.html}" )'
        """

