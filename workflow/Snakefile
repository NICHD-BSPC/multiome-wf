rule build_guide:
    """
    Builds initial version of guide.rst
    """
    input:
        "config/other-setup/guide_template.rst"
    output:
        "../report/guide.rst"
    params:
        sampletable = config["samples"]
    resources:
        mem_mb=1024 * 20,
        disk_mb=1024 * 10,
        runtime=10
    shell:
        # returns guide.rst with report.html file paths in the results directory
        """
        find results -print | grep report.html > reportlist.txt
        cat {params.sampletable} | tr '[:space:]' '[\n*]' | grep / > cellrangerlist.txt
        while read p
        do
            if [[ "$p" == "Downstream output reports" ]]
            then
                echo "$p\n" >> {output}
                while read l
                do
                    # update result name
                    result_name=$(dirname "$l" | sed 's/results\///')
                    line="$l"
                    # escape bash variables by doubling them
                    echo "- \`${{result_name}} <${{line}}>\`_\n" >> {output}
                done < reportlist.txt
            elif [[ "$p" == "Cellranger output directory" ]]
            then
                echo "$p\n" >> {output}
                while read f
                do
                    file='- `cellranger_output <'"$f"'>`_\n'
                    echo "$file" >> {output}
                done < cellrangerlist.txt
            elif [[ "$p" == ":local:" ]]
            then
                echo "\t:local:" >> {output}
            else
                echo "$p" >> {output}
            fi
        done < {input}
        rm reportlist.txt cellrangerlist.txt
        """


