            params=params,
            output_file = "{output.html}")'
        """

rule chromsizes:
    """
    Creates a chromsizes table from fasta
    """
    input:
        config["macs2"]["fasta"]
    output:
        config["macs2"]["chromsizes"]
    log:
        f'{config["macs2"]["fasta"]}.log'
    params:
        # NOTE: Be careful with the memory here; make sure you have enough
        # and/or it matches the resources you're requesting in the cluster
        # config.
        java_args='-Xmx20g'
        # java_args='-Xmx2g'  # [TEST SETTINGS -1]
    resources:
        mem_mb=1024 * 24,
        disk_mb=1024 * 12,
        runtime=60 * 1
    shell:
        'export LC_COLLATE=C; '
        'rm -f {output}.tmp '
        '&& picard '
        '{params.java_args} '
        'CreateSequenceDictionary R={input} O={output}.tmp &> {log} '
        '&& grep "^@SQ" {output}.tmp '
        '''| awk '{{print $2, $3}}' '''
        '| sed "s/SN://g;s/ LN:/\\t/g" '
        '| sort -k1,1 > {output} '
        '&& rm -f {output}.tmp '


rule bigwig_signal:
    """
    Creates a bigwig file for peak intensity from macs2-generated bedGraph
    """
    input:
        chrom = config["macs2"]["chromsizes"],
        bdg = "results/macs2/NA_treat_pileup.bdg",
    output:
        "results/macs2/NA_treat_pileup.bigwig",
    resources:
        mem_mb=1024 * 20,
        disk_mb=1024 * 10,
        runtime=60 * 1
    shell:
        """
        awk 'NR==FNR {{chr_size[$1]=$2; next}}
             {{if ($3 > chr_size[$1]) $3 = chr_size[$1]; print}}' {input.chrom} {input.bdg} > {input.bdg}.temp
        bedClip {input.bdg} {input.chrom} {input.bdg}.temp
        bedGraphToBigWig {input.bdg}.temp {input.chrom} {output}
        rm {input.bdg}.temp
        """

