####### all inputs ############

def all_input(wildcards):
    wanted_input = []

    if is_activated("diff_analysis"):
        wanted_input.extend(
            expand(
                "results/diff_analysis/{seurat}/markers.tsv",
                seurat=valid_groups['diff_analysis']
            )
        )

    # gather path to combine as many seurat objects as possible
    wanted_input.append(
        "results/combine/seurat_combined.rds"
    )

    # Downstream analyses following chooseR, append to 'wanted_input' here.
    # other cool stuff here...

    if config["guide"] == "build":
        wanted_input.append(
            "../report/guide.rst"
        )
    elif config["guide"] == "render":
        wanted_input.append(
            "../report/guide.html"
        )

    return wanted_input


