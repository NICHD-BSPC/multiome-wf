rule combine:
    """
    Merge all Seurat objects created during rules cluster and weighted_nn.
    Input  objects have 1 normalized, scaled assay, dim. reduction,
    cluster identities from SNN and/or WNN community detection.
    Merges non-greedily: if all cell barcodes in 2 objects identical merge objects.
    If unique cell barcodes exist in either object, objects not merged.
    """
    input:
        markdown = "combine.Rmd",
        seurats = cluster_input,
        config = ancient(configuration),
    output:
        html = "results/combine/report.html",
        seurat_out = "results/combine/seurat_combined.rds",
    threads: 12
    resources:
        mem_mb=1024 * 400,     # 1024 * 1000 for real multiome dataset
        disk_mb=1024 * 200,    # 1024 * 500 for real multiome dataset
        runtime=60 * 24
    shell:
        """Rscript -e 'params = list(
                seurats = "{input.seurats}",
                config = "{input.config}",
                seurat_out = "{output.seurat_out}" );
            rmarkdown::render("{input.markdown}",
                params = parameters,
                output_file = "{output.html}")'
        """



