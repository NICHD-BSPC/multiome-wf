        """

rule chooser_paral:
    """
    (Optional)
    Runs chooseR for clustering resolution selection to calculate silhouette scores per cluster 
    on iteratively sampled cells

    Reference: https://pubmed.ncbi.nlm.nih.gov/33522897
    """
    input:
        markdown = "chooser_paral.Rmd",
        seurat_in = get_cluster_inputs,
        config = ancient(configuration),
    output:
        html = "results/chooser_run/{seurat}/res_{res}/report.html",
        output_dir = directory("results/chooser_run/{seurat}/res_{res}"),
        calculation_rds = expand("results/chooser_run/{{seurat}}/{sil}_{{res}}.rds", sil=chooser_sil),
        seurat_rds = "results/chooser_run/{seurat}/seurat_obj_{res}.rds",
    params:
        results_path = "results/chooser_run/{seurat}",
        seurat_out = "{seurat}",
        scriptdir = "scripts",
        intermediates_dir = "results/chooser_run/intermediates_dir/{seurat}/res_{res}"
    threads: 12
    resources:
        mem_mb = 1024 * 100,
        disk_mb = 1024 * 50,
        runtime = 720
    conda:
        "chooser/env.yaml"
    shell:
        """
        Rscript -e 'params = list(
                seurat_in = "{input.seurat_in}",
                config = "{input.config}",
                calculation_outs = "{output.calculation_rds}",
                seurat_rds = "{output.seurat_rds}",
                seurat_out = "{params.seurat_out}",
                results_path = "{params.results_path}",
                res = "{wildcards.res}",
                scriptdir = "{params.scriptdir}");
            rmarkdown::render("{input.markdown}",
                params = params,
                intermediates_dir = "{params.intermediates_dir}",
                output_dir = "{output.output_dir}",
                output_file = "{output.html}")'
        rm -rf {params.intermediates_dir}
        """

rule chooser_aggr:
    """
    (Optional)
    - creates exploratory plots for individual resolutions and silhouette scores
    - calculates optimal resolution
    """
    input:
        markdown = 'chooser_aggr.Rmd',      # chooser - results
        sil_obj = expand(
            'results/chooser_run/{{seurat}}/{sil}_{res}.rds',
            sil=chooser_sil,
            res=resolutions),
        config = ancient(configuration)
    output:
        html = "results/chooser_plot/{seurat}/report.html",
        output_dir = directory("results/chooser_plot/{seurat}"),
        seurat_rds = "results/chooser_plot/{seurat}/clustered_data.rds",
        choice_rds = "results/chooser_plot/{seurat}/choice.rds",
    params:
        resolutions = resolutions,
        res_path = "results/chooser_run/{seurat}",
        new_path = "results/chooser_plot/{seurat}",
        intermediates_dir = "results/chooser_plot/intermediates_dir/{seurat}",
    conda:
        "chooser/env.yaml"
    threads: 12
    resources:
        mem_mb=1024 * 150,
        disk_mb=1024 * 100,
        runtime=60 * 1
    shell:
        """
        Rscript -e 'params = list(
            sil_obj="{input.sil_obj}",
            results_path="{params.res_path}",
            new_path = "{params.new_path}",
            config = "{input.config}",
            seurat = "{wildcards.seurat}",
            seurat_out = "{output.seurat_rds}",
            choice_out = "{output.choice_rds}");
        rmarkdown::render("{input.markdown}",
            params = params,
            intermediates_dir = "{params.intermediates_dir}",
            output_dir = "{output.output_dir}",
            output_file = "{output.html}")'
        rm -rf {params.intermediates_dir}
        """

rule prep_cluster:
    """
    Prepare an RDS file storing the resolution of clustering

    NOTE: Configure `cluster` in your config.yaml
    """
    input:
        seurat_in = get_cluster_inputs
    output:
        "results/prep_cluster/{seurat}/choice.rds"
    params:
        res_use = user_resolution
    threads: 1
    shell:
        """
        Rscript -e 'res <- {params.res_use}; saveRDS(res, "{output}")'
        """

rule cluster:
    """
    - runs clustering and UMAP
    - creates exploratory UMAP plots
    """
    input:
        markdown = "cluster.Rmd",      # chooser - results
        seurat_in = get_cluster_inputs,
        res_choice = lambda wildcards:( 
            f"results/chooser_plot/{wildcards.seurat}/choice.rds"
            if pd.isnull(user_resolution)
            else f"results/prep_cluster/{wildcards.seurat}/choice.rds"
        ),
        config = ancient(configuration),
    output:
        html = "results/cluster/{seurat}/report.html",
        output_dir = directory("results/cluster/{seurat}"),
        seurat_out = "results/cluster/{seurat}/clustered_data.rds",
        barcodes_out = "results/cluster/{seurat}/barcodes.rds",
    params:
        intermediates_dir = "results/cluster/intermediates_dir/{seurat}"
    threads: 12
    resources:
        mem_mb=1024 * 100,
        disk_mb=1024 * 50,
        runtime=60 * 24
        # mem_mb=1024 * 200,
        # disk_mb=1024 * 100,
        # runtime=60 * 24
    shell:
        """
        Rscript -e 'params = list(
            seurat_in = "{input.seurat_in}",
            config = "{input.config}",
            res_choice = "{input.res_choice}",
            seurat = "{wildcards.seurat}",
            seurat_out = "{output.seurat_out}",
            barcodes_out = "{output.barcodes_out}");
        rmarkdown::render("{input.markdown}",
            params = params,
            intermediates_dir = "{params.intermediates_dir}",
            output_dir = "{output.output_dir}",
            output_file = "{output.html}")'
        rm -rf {params.intermediates_dir}
        """

rule weighted_nn:
    """
    - filters cells existing in both modalities
    - builds a Seurat object consisting of assays and dimensionality reductions for both modalities
    - finds multimodal neighbors
    - runs UMAP and clustering
    - creates exploratory plots
    """
    input:
        markdown = "weighted_nn.Rmd",
        seurats =expand(
            "results/cluster/{seurat}/clustered_data.rds",
            seurat=snn_targets),
        config = ancient(configuration),
    output:
        html = "results/wnn/{seurat}/report.html",
        seurat_out = "results/wnn/{seurat}/clustered_data.rds",
        barcodes_out = "results/wnn/{seurat}/barcodes.rds",
    params:
        scriptdir = "scripts",
    threads: 12
    resources:
        mem_mb=1024 * 100,
        disk_mb=1024 * 50,
        runtime=60 * 12
        # mem_mb=1024 * 600,
        # disk_mb=1024 * 300,
        # runtime=60 * 12
    shell:
