rule combine:
    """
    - merges all dimensionality reductions and metadata info created during rules cluster
      and weighted_nn (if present) into one Seurat objects
    - returns a list of Seurat objects
    - Seurat objects are combined only if they contain identical barcodes
    """
    input:
        markdown = "combine.Rmd",
        seurats = cluster_input,
        config = ancient(configuration),
    output:
        html = "results/combine/report.html",
        seurat_out = "results/combine/seurat_combined.rds",
    threads: 12
    resources:
        mem_mb=1024 * 100,
        disk_mb=1024 * 50,
        runtime=60 * 24
        # mem_mb=1024 * 1000,
        # disk_mb=1024 * 500,
        # runtime=60 * 24
