rule normalize_reduce_dims:
    """
    Pre-process unitegrated data.
    Splits Seurat object from combine_seurat into a list of Seurat objects,
    each object containing 1 assay. Checks for and removes imputed zero values
    generated during combine_seruat step to retain only 'true' counts,
    (the imputed zeros are very problematic).
    For each assay, perform log, sct or lsi normalization. One norm per assay.
    Linear and non-linear dimensional reductions are stored in unique dim red key:
    using format: paste0(assay_name, "_", reduction_type)
    Example("gene.expression_pca").
    Rule returns a list of Seurat objects, each element containing one assay.
    Exception is when 2 assays have identical cells (Multiome, CITE-Seq),
    in which case, will the list element will be a seruat object containing
    all assays with equal cell count (Seurat object with 2 assays.)
    Fix later: This behavior should probably be changed to ensure
    each output list element contains Seurat object with one and only one assay.
    Fix later: If each list element contains only one assay,
    possibly change dim reduction keys to 'pca/lsi' or 'umap' for easy access
    in downstream rules easier to fix. Check if this is viable.
    """
    input:
        markdown = "normalize_reduce_dims.Rmd",
        seurat_in = determine_input(),
        config = ancient(configuration),
    output:
        html = "results/normalize_reduce_dims/{seurat}/{seurat}.report.html",
        seurat_out = "results/normalize_reduce_dims/{seurat}/{seurat}.rds",
        output_dir = directory("results/normalize_reduce_dims/{seurat}")
    params:
        scriptdir = "scripts",
        intermediates_dir="results/normalize_reduce_dims/intermediates_dir/{seurat}",
    threads: 12
    resources:
        mem_mb=1024 * 200,
        disk_mb=1024 * 100,
        runtime=60 * 24
    shell:
        """Rscript -e 'params = list(
                seurat_in = "{input.seurat_in}",
                config = "{input.config}",
                seurat_out = "{output.seurat_out}",
                scriptdir = "{params.scriptdir}" );
            rmarkdown::render("{input.markdown}",
                params = params,
                output_dir="{output.output_dir}",
                intermediates_dir = "{params.intermediates_dir}",
                output_file = "{output.html}" )'
        """

rule integrate:
    """
    Perform one or more integration based on sample.tsv or units.tsv columns.
    Note that imputed zeros from combine_seruat rule are note used for integration.
    Fix later: check if imputed zeros still exist and possibly remove from the
    pre- and/or post-integrated objects.
    Add more columns to sample.tsv or units.tsv for new integration combinations.
    Returns list of Seurat objects, each object contains one integration.
    """
    input:
        markdown = "integrate.Rmd",
        seurat_in = determine_input(),
        config = ancient(configuration),
    output:
        html = "results/integrate/{seurat}.report.html",
        seurat_out = "results/integrate/{seurat}.rds",
    threads: 32
    resources:
        mem_mb=1024 * 400,     # 1024 * 1000 for real multiome dataset
        disk_mb=1024 * 200,    # 1024 * 500 for real multiome dataset
        runtime=60 * 24
    shell:
        """Rscript -e 'params = list(
                seurat_in = "{input.seurat_in}",
                config = "{input.config}",
                seurat_out = "{output.seurat_out}" );
            rmarkdown::render("{input.markdown}",
                params = params,
                output_file = "{output.html}" )'
        """


rule chooser_paral:
    """
    Runs chooseR
    """
    input:
        markdown = "chooser_paral.Rmd",   # chooser - parallelized
        seurat_in = get_cluster_inputs,
        config = ancient(configuration),
    output:
        html = "results/chooser_run/{seurat}/res_{res}/report.html",
        output_dir = directory("results/chooser_run/{seurat}/res_{res}"),
        calculation_rds = expand("results/chooser_run/{{seurat}}/{sil}_{{res}}.rds", sil=chooser_sil),
        seurat_rds = "results/chooser_run/{seurat}/seurat_obj_{res}.rds",
    params:
        results_path = "results/chooser_run/{seurat}",
        seurat_out = "{seurat}",
        scriptdir="scripts",
        intermediates_dir = "results/chooser_run/intermediates_dir/{seurat}/res_{res}",
    threads: 12
    resources:
        mem_mb=1024 * 200,
        disk_mb=1024 * 100,
        runtime=60 * 12
    conda:
        "chooser/env.yaml"
    shell:
        """Rscript -e 'params = list(
                seurat_in = "{input.seurat_in}",
                config = "{input.config}",
                calculation_outs = "{output.calculation_rds}",
                seurat_rds = "{output.seurat_rds}",
                seurat_out = "{params.seurat_out}",
                results_path = "{params.results_path}",
                res = "{wildcards.res}",
                scriptdir = "{params.scriptdir}" );
            rmarkdown::render("{input.markdown}",
                params = params,
                intermediates_dir = "{params.intermediates_dir}",
                output_dir = "{output.output_dir}",
                output_file = "{output.html}")'
        """

