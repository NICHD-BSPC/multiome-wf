####### helpers ###########

def is_activated(xpath):
    """Rule selected rule?"""
    c = config
    for entry in xpath.split("/"):
        c = c.get(entry, {})
    return bool(c.get("activate", False))

def get_anno_rmd(wildcards):
    if config["ANNOTATION"] == "EnsDb":
        annofile='annotation_ensdb.Rmd'
    else:
        annofile='annotation_gtf.Rmd'
    return annofile

def get_tenx_type(wildcards):
    """Get matrix type (column name) from sample sheet."""
    cols = ['HDF5_Multiple_Assays', 'RDS_Multiple_Assays', 'Gene.Expression', 'Peaks', 'TF']
    # df = samples.loc[wildcards.sample, cols] # does not account for replicates
    if wildcards.replicate == 'nan':
        samp_mask = samples["sample"]==wildcards.sample
        df = samples[samp_mask]
    else:
        samp_mask = samples["sample"]==wildcards.sample
        rep_mask = samples["replicate"]==wildcards.replicate
        df = samples[samp_mask & rep_mask]
    df = df.loc[:,cols].dropna(axis=1)
    tenx_type = df.columns.to_list()
    return tenx_type

def get_tenx(wildcards):
    """Get filtered matrix (hdf5/rds file or mex directory) path from sample sheet."""
    cols = ['HDF5_Multiple_Assays', 'RDS_Multiple_Assays', 'Gene.Expression', 'Peaks', 'TF']
    # df = samples.loc[wildcards.sample, cols] # does not account for replicates
    if wildcards.replicate == 'nan':
        samp_mask = samples["sample"]==wildcards.sample
        df = samples[samp_mask]
    else:
        samp_mask = samples["sample"]==wildcards.sample
        rep_mask = samples["replicate"]==wildcards.replicate
        df = samples[samp_mask & rep_mask]
    df = df.loc[:,cols].dropna(axis=1)
    tenx_path = df.values.flatten().tolist()
    return tenx_path

def get_tsv_path(xpath):
    if os.path.exists(xpath):
        return xpath
    else:
        return ""

def get_groups(xpath):
    """Get group names from selected config section"""
    c = config
    groups = c.get(xpath, {}).get("groups", {})
    group_names = list(groups.keys())
    return group_names

def get_assays(xpath, assay_type=None):
    """Get assay names from selected config section.
    If using group integrate, need to specify assay_type"""
    c = config
    groups = c.get(xpath, {}).get("groups", {})
    # group_vals is a list of dict_values
    group_vals = list(groups.values())
    assay_names = []
    if assay_type is None:
        for x in group_vals:
            # get dict for given group values
            assay_name = x.get("assay_name", {})
            assay_names.append(assay_name)
    else:
        for x in group_vals:
            # get dict for given group values
            assay_name = x.get(assay_type, {}).get("assay_name", {})
            assay_names.append(assay_name)
    return assay_names


####### rule inputs ###########

def get_coembed_input(wildcards):
    """If present, select seurat object to for rule input."""
    if is_activated("integrate"):
        seurat_obj = [
        "results/process/unintegrated.rds",
        "results/process/integrated.rds"
        ]
    else:
        seurat_obj = [
        "results/process/unintegrated.rds"
        ]
    return seurat_obj

def get_cluster_inputs(wildcards):
    seurat = wildcards.seurat
    r = re.compile(seurat)
    unintegrated_list = get_groups("normalize")
    matches = list(filter(r.match, unintegrated_list))
    if (len(matches) > 0):
        seurat_obj = "results/normalize_reduce_dims/{seurat}/{seurat}.rds"
    else:
        seurat_obj = "results/integrate/{seurat}/{seurat}.rds"
    return seurat_obj

def get_diff_test_input(wildcards):
    seurat = wildcards.seurat
    r = re.compile(seurat)
    weighted_nn_list = get_groups("weighted_nn")
    matches = list(filter(r.match, weighted_nn_list))
    if (len(matches) > 0):
        seurat_obj = "results/wnn/{seurat}/clustered_data.rds"
    else:
        seurat_obj = "results/cluster/{seurat}/clustered_data.rds"
    return seurat_obj

def determine_input():
    if config["macs2"]["run"] == "Y":
        return "results/add_macs_peaks/seurat.rds"
    elif config["macs2"]["run"] == "N":
        return "results/merge_zinba/seurat.rds"
    else:
        raise ValueError("Incorrect macs2 configuration - set 'Y' or 'N'")


####### valid inputs ##########

def get_snn_targets():
    # Gather files for clustering. 
    # Either shared nearest neighbor or 
    # weighted nearest neighbor methods.
    unintegrated_list = get_groups("normalize")
    snn_targets = unintegrated_list[:] # copy values not reference
    # # for filtering out "MACS" assays, if needed
    # unintegrated_assays = get_groups("normalize")
    # snn_assays = unintegrated_assays[:]
    if config["macs2"]["run"] == "N":
        from itertools import compress
        # snn_targets.remove("unintegrated_2")
        # find any unitegrated assays containing "MACS"
        assays_list = get_assays("normalize")
        # subset snn_targets based on logicals checking "MACS"
        idx = [item != "MACS" for item in assays_list]
        snn_targets = list(compress(snn_targets, idx))
    if is_activated("integrate"):
        integrated_list = get_groups("integrate")
        if config["macs2"]["run"] == "N":
            # find any reference/query assays containing "MACS"
            assays_ref = get_assays("integrate", assay_type = "reference")
            idx_ref = np.array([item != "MACS" for item in assays_ref])
            assays_query = get_assays("integrate", assay_type = "query")
            idx_query = np.array([item != "MACS" for item in assays_query])
            # numpy compare, retain 'false' if idx_ref or idx_query has a false
            idx = list(idx_ref & idx_query)
            integrated_list = list(compress(integrated_list, idx))
        snn_targets.extend(integrated_list)
    if is_activated("coembed"):
        coembed_list = get_groups("coembed")
        snn_targets.extend(coembed_list)
        # fix later as with 'if config["macs2"] == "N"'
        # coembed_assays = get_assays("coembed")
        # snn_assays.extend(coembed_assays)
    return snn_targets

snn_targets = get_snn_targets()


def get_valid_groups():
    # it's easy to accidentally add analysis groups for optional rules
    # this filters out out groups that don't match across groups
    # get activations and groups for each config section:
    a = {}
    d = {}
    for i in config.keys():
        # print(i)
        if isinstance (config[i], dict) or isinstance (config[i], OrderedDict):
            # print("is")
            c = config[i]
            if "activate" in c.keys():
                a[i] = c['activate']
                # print(c.keys())
                d[i] = c['groups']
        else:
            # print("not")
            d[i] = None
    dd = {key:val for key, val in d.items() if val != None}
    for key, value in a.items():
        if not value:
            del dd[key]
    if is_activated("weighted_nn"):
        # print("weighted_nn activated")
        dw = dd['weighted_nn']
        del dd['weighted_nn']
    dd['normalize'] = config['normalize']['groups']
    df = pd.DataFrame.from_dict(dd)
    g = {}
    for i in df.columns:
        # print(i)
        targets = snn_targets[:]
        if is_activated("weighted_nn"):
            targets.extend(list(dw.keys()))
        df_filter = df.loc[[item in targets for item in df.index], :]
        df_filter = df_filter.dropna(subset=[i]).index
        df_filter =df_filter.unique().to_list()
        g[i] = df_filter
    if is_activated("weighted_nn"):
        h = {}
        for key, value in dw.items():
            h[key] = dw[key]['input_groups']
        for key, value in h.items():
            if not all([item in targets for item in h['wnn_0']]):
                del h[key]
        if bool(h):
            g['weighted_nn'] = list(h.keys())
    valid_groups = g
    return valid_groups

valid_groups = get_valid_groups()

print(valid_groups)    # uncomment for testing

