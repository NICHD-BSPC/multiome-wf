rule cluster:
    """
    Cluster each unintegrated or integrated assay based on Chooser results
    """
    input:
        markdown = "cluster.Rmd",      # chooser - results
        seurat_in = get_cluster_inputs,
        res_choice = "results/chooser_plot/{seurat}/choice.rds",
        config = ancient(configuration),
    output:
        html = "results/cluster/{seurat}/report.html",
        output_dir = directory("results/cluster/{seurat}"),
        seurat_out = "results/cluster/{seurat}/clustered_data.rds",
        barcodes_out = "results/cluster/{seurat}/barcodes.rds",
    params:
        intermediates_dir = "results/cluster/intermediates_dir/{seurat}",
        res_use = config["cluster"]["resolution"]
    threads: 12
    resources:
        mem_mb=1024 * 100,
        disk_mb=1024 * 50,
        runtime=60 * 24
        # mem_mb=1024 * 200,
